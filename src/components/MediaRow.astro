---
import type { Post } from '../lib/posts'
import { strings, type Lang } from '../lib/i18n'
import { mediaUrl, telegramUrl } from '../lib/urls'
import { preview } from '../lib/preview'
import Picture from './Picture.astro'

interface Props {
	media: Post['media']
	telegramId: number
	lang: Lang
	eager?: boolean
}

const { media, telegramId, lang, eager = false } = Astro.props
const t = strings[lang]
const single = media.length === 1
type Item = Props['media'][number]

// The image or video poster, whose preview dithers until it arrives
const still = (item: Item) => (item.type === 'image' ? item.file : item.type === 'video' ? item.poster : undefined)
const previews = await Promise.all(media.map((item) => preview(still(item), item.width)))
const slotStyle = (index: number) => (previews[index] ? `--preview: url(${previews[index]})` : undefined)

// From 64rem a post is a third of the window less the page padding; below, at most 40rem. A slot of
// several takes --media-lead (80%)
const sizes = single
	? '(min-width: 64rem) calc((100vw - 8rem) / 3), (min-width: 45rem) 40rem, 92vw'
	: '(min-width: 64rem) calc((100vw - 8rem) / 3.75), (min-width: 45rem) 32rem, 74vw'
const picture = (file: string, item: Item, index: number) => ({
	file,
	width: item.width,
	height: item.height,
	sizes,
	eager: eager && index === 0,
})
---

<div class="media" data-media-row data-single={single || undefined}>
	<ul class="track" data-media-track>
		{media.map((item, index) => (
			<li class="slot" style={slotStyle(index)} data-slot data-dither data-loading={still(item) ? true : undefined}>
				{still(item) && <span class="dither" aria-hidden="true" />}
				{item.type === 'unavailable' ? (
					<a class="item unavailable" href={item.messageId ? telegramUrl(item.messageId, true) : telegramUrl(telegramId)}>
						{item.poster && <Picture {...picture(item.poster, item, index)} />}
						<span class="label">{t.unavailable} <span aria-hidden="true">↗</span></span>
					</a>
				) : (
					<button class="item" type="button" data-open aria-label={`${t.open} ${index + 1}/${media.length}`}>
						{item.type === 'image' ? (
							<Picture {...picture(item.file, item, index)} />
						) : (
							<>
								{/* A picture under the video, not its poster attribute, which loads at once and at one size */}
								{item.poster && <Picture {...picture(item.poster, item, index)} />}
								<video
									src={mediaUrl(item.file)}
									width={item.width}
									height={item.height}
									muted
									loop
									playsinline
									preload={item.poster ? 'none' : 'metadata'}
									data-autoplay
								/>
							</>
						)}
					</button>
				)}
			</li>
		))}
	</ul>
	{!single && (
		<>
			<button class="nav prev" type="button" tabindex="-1" aria-label={t.previous} data-media-prev data-off>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
			</button>
			<button class="nav next" type="button" tabindex="-1" aria-label={t.next} data-media-next>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
			</button>
		</>
	)}
</div>

<style lang="sass">
// Picture.astro's elements are reached with :global()

.media
    position: relative

.track
    // Offset parent of the slots, for drag.ts
    position: relative
    display: flex
    gap: var(--media-gap)
    overflow-x: auto
    overscroll-behavior-x: contain
    scroll-snap-type: x mandatory
    scrollbar-width: none

    &::-webkit-scrollbar
        display: none

    // Mid-drag (drag.ts)
    &[data-dragging]
        user-select: none

        .item
            cursor: grabbing

.slot
    position: relative
    flex: 0 0 var(--media-lead)
    aspect-ratio: var(--media-ratio)
    scroll-snap-align: start
    background: var(--surface)
    // Off screen, the browser skips painting it, dither and all. Its size comes from the width and ratio
    content-visibility: auto

    .media[data-single] &
        flex-basis: 100%

    // The tint, over media and dither. The viewer copies only the picture or video, so stays untinted
    &::after
        content: ""
        position: absolute
        inset: 0
        background: var(--media-tint)
        mix-blend-mode: var(--media-tint-blend)
        pointer-events: none

.item
    position: relative
    display: block
    width: 100%
    height: 100%
    cursor: zoom-in

    &:focus-visible
        outline-offset: calc(var(--focus-width) * -1)

    :global(picture)
        display: contents

    :global(img),
    video
        width: 100%
        height: 100%
        object-fit: cover

    // Over its poster picture, which shows until the first frame
    video
        position: absolute
        inset: 0

    &.unavailable
        color: var(--secondary)
        cursor: pointer

    // A row of several drags with a mouse (drag.ts)
    @media (hover: hover) and (pointer: fine)
        .media:not([data-single]) &
            cursor: grab

.label
    position: absolute
    inset-inline-start: 0
    inset-block-end: 0
    padding: var(--space-xs) var(--space-s)
    background: var(--overlay)

.nav
    position: absolute
    top: 50%
    display: grid
    place-items: center
    width: var(--media-nav-size)
    height: var(--media-nav-size)
    translate: 0 -50%
    background: var(--overlay)
    color: var(--primary)
    opacity: 0
    visibility: hidden
    transition: opacity var(--duration-base) var(--ease), visibility var(--duration-base)

    svg
        width: 50%
        height: 50%
        fill: none
        stroke: currentColor
        stroke-width: 1.5

    &.prev
        inset-inline-start: var(--space-xs)

    &.next
        inset-inline-end: var(--space-xs)

    // Chevrons for a mouse only
    @media (hover: hover) and (pointer: fine)
        .media:hover &:not([data-off])
            opacity: 1
            visibility: visible
</style>
