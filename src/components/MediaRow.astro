---
import type { Post } from '../lib/posts'
import { strings, type Lang } from '../lib/i18n'
import { mediaUrl, telegramUrl } from '../lib/urls'
import { preview } from '../lib/preview'
import Picture from './Picture.astro'

interface Props {
	media: Post['media']
	telegramId: number
	lang: Lang
	eager?: boolean
}

const { media, telegramId, lang, eager = false } = Astro.props
const t = strings[lang]
const single = media.length === 1
// With JS, every picture but the first post's first waits in a <noscript> until it nears the window, or
// its row is scrolled (media.ts)
const held = (index: number) => !(eager && index === 0)

// Previews shown dithered until the image or video poster arrives
const still = (item: Props['media'][number]) =>
	item.type === 'image' ? item.file : item.type === 'video' ? item.poster : undefined
const previews = await Promise.all(media.map((item) => preview(still(item), item.width)))
const slotStyle = (index: number) => (previews[index] ? `--preview: url(${previews[index]})` : undefined)

// From 64rem a post is a third of the window less 4rem of padding on each side (--scatter-span of
// --scatter-columns); below, the container is at most 40rem. With several items a slot takes 80% (--media-lead)
const sizes = single
	? '(min-width: 64rem) calc((100vw - 8rem) / 3), (min-width: 45rem) 40rem, 92vw'
	: '(min-width: 64rem) calc((100vw - 8rem) / 3.75), (min-width: 45rem) 32rem, 74vw'
---

<div class="media" data-media-row data-single={single || undefined}>
	<ul class="track" data-media-track>
		{media.map((item, index) => (
			<li class="slot" style={slotStyle(index)} data-slot data-dither data-loading={still(item) ? true : undefined}>
				{still(item) && <span class="dither" aria-hidden="true" />}
				{item.type === 'unavailable' ? (
					<a class="item unavailable" href={item.messageId ? telegramUrl(item.messageId, true) : telegramUrl(telegramId)}>
						{item.poster && <Picture file={item.poster} width={item.width} height={item.height} sizes={sizes} eager={eager && index === 0} later={held(index)} />}
						<span class="label">{t.unavailable} <span aria-hidden="true">↗</span></span>
					</a>
				) : (
					<button class="item" type="button" data-open aria-label={`${t.open} ${index + 1}/${media.length}`}>
						{item.type === 'image' ? (
							<Picture file={item.file} width={item.width} height={item.height} sizes={sizes} eager={eager && index === 0} later={held(index)} />
						) : (
							<>
								{/* The poster is a lazy picture under the video rather than its poster attribute, which loads eagerly and at one size */}
								{item.poster && <Picture file={item.poster} width={item.width} height={item.height} sizes={sizes} eager={eager && index === 0} later={held(index)} />}
								<video
									src={mediaUrl(item.file)}
									width={item.width}
									height={item.height}
									muted
									loop
									playsinline
									preload={item.poster ? 'none' : 'metadata'}
									data-autoplay
								/>
							</>
						)}
					</button>
				)}
			</li>
		))}
	</ul>
	{!single && (
		<>
			<button class="nav prev" type="button" tabindex="-1" aria-label={t.previous} data-media-prev data-off>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
			</button>
			<button class="nav next" type="button" tabindex="-1" aria-label={t.next} data-media-next>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
			</button>
		</>
	)}
</div>

<style lang="sass">
// The media row. Picture.astro's elements are reached with :global()

.media
    position: relative

.track
    // Offset parent of the slots, whose positions drag.ts reads
    position: relative
    display: flex
    gap: var(--media-gap)
    overflow-x: auto
    overscroll-behavior-x: contain
    scroll-snap-type: x mandatory
    scrollbar-width: none

    &::-webkit-scrollbar
        display: none

    // Mid-drag (drag.ts): the hand closes, and nothing gets selected
    &[data-dragging]
        user-select: none

        .item
            cursor: grabbing

.slot
    position: relative
    flex: 0 0 var(--media-lead)
    aspect-ratio: var(--media-ratio)
    scroll-snap-align: start
    background: var(--surface)

    .media[data-single] &
        flex-basis: 100%

    // The tint (--media-tint), over the media and the loading dither. The viewer copies only the
    // picture or video, so it shows them untinted
    &::after
        content: ""
        position: absolute
        inset: 0
        background: var(--media-tint)
        mix-blend-mode: var(--media-tint-blend)
        pointer-events: none

.item
    position: relative
    display: block
    width: 100%
    height: 100%
    cursor: zoom-in

    &:focus-visible
        outline-offset: calc(var(--focus-width) * -1)

    :global(picture)
        display: contents

    :global(img),
    video
        width: 100%
        height: 100%
        object-fit: cover

    // Over its poster picture, which shows until the first frame
    video
        position: absolute
        inset: 0

    &.unavailable
        color: var(--secondary)
        cursor: pointer

    // A row of several drags with a mouse (drag.ts); a click without moving still opens the viewer
    @media (hover: hover) and (pointer: fine)
        .media:not([data-single]) &
            cursor: grab

.label
    position: absolute
    inset-inline-start: 0
    inset-block-end: 0
    padding: var(--space-xs) var(--space-s)
    background: var(--overlay)

.nav
    position: absolute
    top: 50%
    display: grid
    place-items: center
    width: var(--media-nav-size)
    height: var(--media-nav-size)
    translate: 0 -50%
    background: var(--overlay)
    color: var(--primary)
    opacity: 0
    visibility: hidden
    transition: opacity var(--duration-base) var(--ease), visibility var(--duration-base)

    svg
        width: 50%
        height: 50%
        fill: none
        stroke: currentColor
        stroke-width: 1.5

    &.prev
        inset-inline-start: var(--space-xs)

    &.next
        inset-inline-end: var(--space-xs)

    // Chevrons for a mouse only
    @media (hover: hover) and (pointer: fine)
        .media:hover &:not([data-off])
            opacity: 1
            visibility: visible
</style>
