---
// Full-screen media viewer. viewer.ts fills it with copies of a post's media and meta, styled with :global()
import { strings, type Lang } from '../lib/i18n'

interface Props {
	lang: Lang
}

const t = strings[Astro.props.lang]
---

<dialog class="viewer" tabindex="-1" aria-label={t.viewer} aria-keyshortcuts="ArrowLeft ArrowRight Escape" data-viewer>
	<div class="bar">
		<button class="close" type="button" data-viewer-close>{t.close}</button>
	</div>
	<ul class="track" data-viewer-track></ul>
	<div class="meta" data-viewer-meta></div>
</dialog>

<style lang="sass">
.viewer
    position: fixed
    inset: 0
    width: 100%
    max-width: none
    height: 100%
    max-height: none
    margin: 0
    padding: 0
    border: 0
    background: var(--background)
    color: var(--primary)
    overflow-y: auto
    overscroll-behavior: contain
    // Slides size against the dialog, which excludes its scrollbar
    container-type: inline-size

    // Focused itself when opened by a pointer (viewer.ts)
    &:focus-visible
        outline: none

    &::backdrop
        background: transparent

    &[open]
        animation: viewer-in var(--duration-base) var(--ease)

    &[data-close-zone]
        cursor: pointer

@keyframes viewer-in
    from
        opacity: 0

.bar,
.meta
    box-sizing: content-box
    max-width: var(--container-width)
    margin-inline: auto
    padding-inline: var(--gutter)

.bar
    display: flex
    justify-content: flex-end
    padding-block: var(--space-m)

.close
    color: var(--secondary)
    transition: color var(--duration-fast) var(--ease)

    // Also lit over the close zone (viewer.ts)
    &:hover,
    &[data-hover]
        color: var(--primary)

.track
    // Offset parent of the slides
    position: relative
    display: flex
    align-items: center
    gap: var(--media-gap)
    overflow-x: auto
    overscroll-behavior-x: contain
    scroll-snap-type: x mandatory
    scrollbar-width: none
    user-select: none

    &::-webkit-scrollbar
        display: none

    // Widths from viewer.ts, so the end slides can reach the middle
    &::before,
    &::after
        content: ""
        flex: none

    &::before
        width: calc(var(--pad-start, 0px) - var(--media-gap))

    &::after
        width: calc(var(--pad-end, 0px) - var(--media-gap))

    // Mid-drag (drag.ts)
    &[data-dragging],
    &[data-dragging] *
        cursor: grabbing

    // A slide (viewer.ts), at the item's own ratio. While loading, its background may be the feed's copy
    :global([data-slide])
        flex: none
        width: min(var(--viewer-media-height) * var(--ratio), var(--viewer-media-max), 100cqw - 2 * var(--gutter))
        aspect-ratio: var(--ratio)
        scroll-snap-align: center
        background: var(--surface) center / cover no-repeat
        cursor: pointer

    // Slides drag with a mouse (drag.ts)
    @media (hover: hover) and (pointer: fine)
        :global([data-slide])
            cursor: grab

    :global([data-slide] picture)
        display: contents

    :global([data-slide] img),
    :global([data-slide] video)
        width: 100%
        height: 100%
        object-fit: contain

.meta
    padding-block: var(--space-l) var(--space-xl)

// Phones: the bar moves to the bottom, near the thumb, and the media and text sit just above it
@media not all and (min-width: 48rem)
    .viewer[open]
        display: flex
        flex-direction: column

        > *
            flex-shrink: 0

    .track
        margin-top: auto

    .bar,
    .meta
        // Auto margins would shrink them in the column
        margin-inline: max(0px, (100% - var(--container-width)) / 2 - var(--gutter))

    .bar
        order: 1
        position: sticky
        bottom: 0
        padding-bottom: calc(var(--space-m) + env(safe-area-inset-bottom))
        background: var(--background)

    .meta
        padding-bottom: 0
</style>
