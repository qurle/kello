---
// Inter from fontsource; Mustica Pro for the heading is in fonts.sass
import '@fontsource-variable/inter/wght.css'
import '../styles/fonts.sass'
import '../styles/variables.sass'
import '../styles/base.sass'
import config from '../../kello.config'
import { getPosts } from '../lib/posts'
import { languages, main, original, ui, type Lang } from '../lib/i18n'
import { filterTags, tagLabel } from '../lib/tags'
import { pageCount, pagePath, pagePosts } from '../lib/pages'
import Post from './Post.astro'
import Viewer from './Viewer.astro'
import feedScript from '../scripts/inline/feed.js?raw'
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import interCyrillic from '@fontsource-variable/inter/files/inter-cyrillic-wght-normal.woff2?url'
import mustica from '../assets/fonts/mustica-pro-semibold.woff2?url'

interface Props {
	lang: Lang
	/** Which page of the feed this is, from 1 */
	page?: number
}

const { lang, page = 1 } = Astro.props
const t = ui(lang)
// The other language, for the switch; none without translation
const other = languages.find((language) => language !== lang)
const all = await getPosts()
// Every tag, not just this page's: picking one loads the other pages
const tags = filterTags(new Set(all.flatMap((post) => post.tags)))
const posts = pagePosts(all, page)
const pages = Array.from({ length: pageCount(all) }, (_, i) => pagePath(lang, i + 1))
const next = pages[page]
const url = (path: string) => new URL(path, config.site.url).href
const { subtitle } = config.site
const subtitleLine = subtitle && (subtitle.lines[lang] ?? subtitle.lines[main] ?? subtitle.lines[original])
// Inter's Cyrillic file for languages written in it, its Latin file for the rest
const cyrillic = ['ru', 'uk', 'be', 'bg', 'sr', 'mk', 'kk', 'ky', 'tg', 'mn']
const locales: Record<Lang, string> = { en: 'en_US', ru: 'ru_RU' }
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<!-- Lets CSS hold the wide feed back until feed.js has placed it, and a shared ?tags= link
		     hold it until filter.ts has loaded every page and filtered. Applies a stored theme before
		     the first paint (theme.ts) -->
		<script is:inline>
			document.documentElement.dataset.js = ''
			if (/[?&]tags=/.test(location.search)) document.documentElement.dataset.filtering = ''
			try {
				const theme = localStorage.getItem('theme')
				if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
			} catch {}
		</script>
		<link rel="preload" href={mustica} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={cyrillic.includes(lang) ? interCyrillic : interLatin} as="font" type="font/woff2" crossorigin />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{config.site.title}</title>
		<meta name="description" content={t.description} />
		<link rel="canonical" href={url(pagePath(lang, page))} />
		{other && languages.map((language) => <link rel="alternate" hreflang={language} href={url(pagePath(language, page))} />)}
		{other && <link rel="alternate" hreflang="x-default" href={url(pagePath(main, page))} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<!-- Link previews: public/og.png, 1200×630 -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={config.site.title} />
		<meta property="og:title" content={config.site.title} />
		<meta property="og:description" content={t.description} />
		<meta property="og:url" content={url(pagePath(lang, page))} />
		<meta property="og:locale" content={locales[lang] ?? lang} />
		<meta property="og:image" content={url('/og.png')} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={config.site.title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<div class="page">
			<header class="masthead">
				<div class="heading">
					<h1 class="title">
						<a href={pagePath(lang, 1)}
							>{config.site.title}<sup><img class="logo" alt="kello logotype" src="/favicon.svg" /></sup
							></a
						>
					</h1>
					{
						subtitle && subtitleLine && (
							<div class="subtitle">
								{subtitleLine.text}{' '}
								<a href={subtitle.url} target="_blank">
									{subtitleLine.link}
								</a>
							</div>
						)
					}
				</div>
				<!-- Each switch names the current state; the theme shows the label for html[data-theme] -->
				<div class="switches">
					<button class="theme" type="button" title={t.themeLabel} data-theme-switch>
						<span class="auto">{t.theme.auto}</span>
						<span class="light">{t.theme.light}</span>
						<span class="dark">{t.theme.dark}</span>
					</button>{other && (
						<> / 
						<a
							class="lang"
							href={pagePath(other, page)}
							hreflang={other}
							aria-label={ui(other).version}
							data-lang-link>{lang}</a
						></>
					)}
				</div>
			</header>
			<nav class="filter" aria-label={t.filter} data-filter>
				<ul class="list">
					{
						tags.map((tag) => (
							<li>
								<button class="tag" type="button" data-tag={tag} aria-pressed="false">
									{tagLabel(tag, lang)}
								</button>
							</li>
						))
					}
				</ul>
			</nav>
			<main class="feed" data-feed data-page={page} data-pages={JSON.stringify(pages)}>
				{
					posts.map((post, index) => (
						<Post post={post} lang={lang} page={page} eager={page === 1 && index === 0} />
					))
				}
			</main>
			{
				next && (
					<a class="more" href={next} rel="next" data-more>
						{t.more}
					</a>
				)
			}
			<script is:inline set:html={feedScript} />
		</div>
		<Viewer lang={lang} />
		<script>
			import '../scripts/filter'
			import '../scripts/media'
			import '../scripts/viewer'
			import '../scripts/pages'
			import '../scripts/theme'
		</script>
	</body>
</html>

<style lang="sass">
	.page
		box-sizing: content-box
		max-width: var(--container-width)
		margin-inline: auto
		padding: var(--page-padding-top) var(--gutter) var(--space-2xl)

		// Wide screens: the page spans the window
		@media (min-width: 64rem)
			max-width: none
			padding-inline: max(var(--page-padding-wide), var(--gutter))

	.masthead
		display: flex
		align-items: end
		gap: var(--space-m)

		.heading
			display: flex
			flex-direction: column
			gap: var(--space-xs)
			flex: 1 1 auto

		.title
			margin-inline-start: var(--display-indent)
			font-family: var(--font-display)
			font-size: var(--text-display)
			font-weight: var(--weight-display)
			line-height: var(--leading-tight)
			letter-spacing: var(--tracking-display)

		.subtitle
			color: var(--secondary)
			line-height: 1.2
			a
				text-decoration: underline
				text-underline-offset: 3px
				&:hover
					color: var(--primary)

		.switches
			display: flex
			gap: var(--space-xs)
			color: var(--secondary)

		.theme,
		.lang
			@media (hover: hover)
				&:hover
					color: var(--primary)

		// Only the current theme's name shows; without JS there's nothing to switch
		.theme span
			display: none

		:global(html:not([data-theme])) & .theme .auto,
		:global(html[data-theme="light"]) & .theme .light,
		:global(html[data-theme="dark"]) & .theme .dark
			display: inline

		:global(html:not([data-js])) & .theme
			display: none

		.logo
			display: inline
			transition: transform var(--duration-base) var(--ease)
			height: 0.4em
			width: auto

		a:hover .logo
			transform: rotate(15deg)

	.filter
		margin-top: var(--space-l)

		.list
			display: flex
			flex-wrap: wrap
			gap: var(--space-2xs) var(--space-s)

		@media (min-width: 48rem)
			display: grid
			grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr))
			column-gap: var(--space-m)
			margin-top: var(--space-xl)

			.list
				grid-column: calc(var(--index-columns) + 1) / -1
				gap: var(--space-2xs) var(--space-m)

		// On the feed's grid, after the index columns
		@media (min-width: 64rem)
			grid-template-columns: repeat(var(--scatter-columns), minmax(0, 1fr))
			column-gap: var(--scatter-gap)

	.feed
		margin-top: var(--space-2xl)

		// A shared ?tags= link: hidden until every page is in and filtered
		:global(html[data-filtering]) &
			visibility: hidden

		// Wide screens: hidden until feed.js has placed the posts
		@media (min-width: 64rem)
			:global(html[data-js]) &:not([data-scatter])
				visibility: hidden

		&[data-scatter]
			position: relative

	// The next page: a link without JS; with it, where pages.ts loads the next
	.more
		display: block
		width: fit-content
		margin-top: var(--post-gap)
		color: var(--secondary)
</style>
