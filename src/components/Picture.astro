---
import { imageSet } from '../lib/urls'

interface Props {
	/** Path without width and extension */
	file: string
	/** Original width: decides which files exist */
	width?: number
	height?: number
	sizes: string
	eager?: boolean
	/** Held back in a <noscript> until media.ts reveals it. Without JS it is an ordinary lazy picture */
	later?: boolean
}

const { file, width, height, sizes, eager = false, later = false } = Astro.props
const { formats, fallbackFormat, src } = imageSet(file, width)
const Wrap = later ? 'noscript' : Fragment
---

<Wrap {...(later ? { 'data-later': '' } : {})}><picture>
	{formats.filter(({ format }) => format !== fallbackFormat).map(({ format, srcset }) => (
		<source type={`image/${format}`} srcset={srcset} sizes={sizes} />
	))}
	<img
		src={src}
		srcset={formats.find(({ format }) => format === fallbackFormat)!.srcset}
		sizes={sizes}
		width={width}
		height={height}
		alt=""
		loading={eager ? 'eager' : 'lazy'}
		fetchpriority={eager ? 'high' : 'auto'}
		decoding="async"
	/>
</picture></Wrap>
