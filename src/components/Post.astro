---
import type { Post } from '../lib/posts'
import { strings, type Lang } from '../lib/i18n'
import { domain, telegramUrl } from '../lib/urls'
import { hash } from '../lib/hash'
import { sortTags, tagLabel } from '../lib/tags'
import MediaRow from './MediaRow.astro'

interface Props {
	post: Post
	lang: Lang
	/** The feed page it is on, so posts fetched from other pages go in order (pages.ts) */
	page: number
	eager?: boolean
}

const { post, lang, page, eager = false } = Astro.props
const t = strings[lang]
const tags = sortTags(post.tags)
---

<article
	class="post"
	data-post={post.telegramId}
	data-page={page}
	data-hash={hash(post.telegramId)}
	data-tags={tags.join(' ')}
>
	{post.media.length > 0 && <MediaRow media={post.media} telegramId={post.telegramId} lang={lang} eager={eager} />}
	<div class="meta" data-post-meta>
		{
			tags.length > 0 && (
				<ul class="tags">
					{tags.map((tag) => (
						<li>
							<button class="tag" type="button" data-tag={tag} aria-pressed="false">
								{tagLabel(tag, lang)}
							</button>
						</li>
					))}
				</ul>
			)
		}
		<div class="body">
			{post.text && <div class="text" set:html={post.text[lang]} />}
			<p class="links">
				{
					post.link && (
						<a class="source" href={post.link}>
							{domain(post.link)} <span aria-hidden="true">↗</span>
						</a>
					)
				}
				<a class="telegram" href={telegramUrl(post.telegramId)}>{t.telegram}</a>
			</p>
		</div>
	</div>
</article>

<style lang="sass">
	// The viewer shows a copy of the meta, which keeps these styles

	.post + .post
		margin-top: var(--post-gap)

	.meta
		display: flex
		flex-direction: column
		gap: var(--space-s)

		// After the media row
		&:not(:first-child)
			margin-top: var(--space-m)

		@media (min-width: 48rem)
			display: grid
			grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr))
			column-gap: var(--space-m)
			align-items: baseline

	.tags
		display: flex
		flex-wrap: wrap
		gap: var(--space-2xs) var(--space-s)

		@media (min-width: 48rem)
			grid-column: 1 / span var(--index-columns)
			flex-direction: column
			gap: 0

	.body
		@media (min-width: 48rem)
			grid-column: calc(var(--index-columns) + 1) / -1

	// Telegram's markup, set as HTML, so reached with :global()
	.text
		max-width: var(--text-width)
		overflow-wrap: break-word

		:global(blockquote)
			margin: 0
			padding-inline-start: var(--space-m)
			color: var(--secondary)

		// Telegram adds a line break after a quote
		:global(blockquote + br)
			display: none

		:global(a)
			text-decoration-line: underline
			text-decoration-thickness: var(--underline-width)
			text-decoration-color: var(--tertiary)
			text-underline-offset: var(--underline-offset)

		:global(a:hover)
			text-decoration-color: currentColor

		:global(b),
		:global(strong)
			font-weight: var(--weight-display)

	.links
		display: flex
		flex-wrap: wrap
		gap: var(--space-2xs) var(--space-m)
		margin-top: var(--space-s)

	.source
		flex-grow: 1
		color: var(--primary)

		// Scoped, the rule above outranks the global a:hover
		&:hover
			color: var(--accent)

	.telegram
		color: var(--secondary)

	// The Telegram link shows in the viewer only, so a feed post without a source has no links line. Media
	// that opens in Telegram ("watch in telegram") stands in for it; a post with neither keeps it
	:global([data-feed]) .post:has([data-open], [data-unavailable])
		.telegram,
		.links:not(:has(.source))
			display: none

	// Wide screens: feed.js places each post and sets data-scatter
	:global(.feed[data-scatter]) .post
		position: absolute
		margin: 0

		.meta
			display: flex
			flex-direction: column
			gap: var(--space-xs)

		.tags
			flex-direction: row
			gap: var(--space-2xs) var(--space-s)

		.links
			margin-top: var(--space-xs)

	// Settle: a post enters rolled back around its bottom edge and stands up over --settle-distance of
	// scrolling; on phones it grows from --settle-scale instead, flat, as a 3D layer per post cost too much there.
	// Only `transform`, so feed.js's layout is untouched. No fill: a post below the window, which can't be
	// seen, holds no transform, so only posts coming in have one
	@supports (animation-timeline: view())
		@media (prefers-reduced-motion: no-preference)
			.post
				transform-origin: 50% 100%
				animation: settle var(--settle-ease)
				animation-timeline: view()
				animation-range: cover 0% cover var(--settle-distance)

				@media (width < 48rem)
					animation-name: grow

	@keyframes settle
		from
			transform: perspective(var(--settle-perspective)) rotateX(var(--settle-angle))

	@keyframes grow
		from
			transform: scale(var(--settle-scale))
</style>
